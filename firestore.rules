rules_version = '2';
// Signed-in Google accounts listed in `team` (document id = email) and every @dome.tu.ac.th account
// can see the shared drive (folders, docs, thumbs) and upload files; only `team` can see clubs.
// Uploaders can change their own files (docs with by = their email) but not delete them for good,
// and make folders of their own inside existing folders (never at the top level).
// role 'editor' can also change folders, all docs, clubs and thumbs (covers of uploaded files).
// admin: true (only with role 'editor') can also manage the team list from the Team page, except their own entry,
// so there is always at least one admin. The first admin is set in the console.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function member() { return signedIn() && exists(/databases/$(database)/documents/team/$(request.auth.token.email)); }
    function editor() { return member() && get(/databases/$(database)/documents/team/$(request.auth.token.email)).data.role == 'editor'; }
    function admin() { return member() && get(/databases/$(database)/documents/team/$(request.auth.token.email)).data.get('admin', false) == true; }
    function org() { return signedIn() && request.auth.token.email.matches('.*@dome[.]tu[.]ac[.]th'); }
    function reader() { return member() || org(); }
    function mine(d) { return d.get('by', '') == request.auth.token.email; }
    function inFolder(d) { return d.get('parent', null) is string && exists(/databases/$(database)/documents/folders/$(d.parent)); }
    function self(email) { return signedIn() && request.auth.token.email == email; }
    function validMember() {
      let d = request.resource.data;
      return d.role in ['viewer', 'editor'] && d.get('admin', false) is bool && (d.get('admin', false) == false || d.role == 'editor');
    }

    match /team/{email} {
      allow read: if self(email) || admin();
      allow create: if admin() && email == email.lower()
        && request.resource.data.keys().hasOnly(['role', 'admin', 'addedBy', 'addedAt'])
        && request.resource.data.addedBy == request.auth.token.email && validMember();
      // Admins change other people's role; everyone stamps their own last sign-in time.
      allow update: if (admin() && !self(email)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'admin']) && validMember())
        || (self(email) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
          && request.resource.data.lastSeen == request.time);
      allow delete: if admin() && !self(email);
    }
    // Assistant photos shared with the team: any member can add one in their own name;
    // the person who added it or an editor can delete it. Photos can't be edited.
    match /mascots/{id} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.keys().hasOnly(['url', 'by', 'createdAt'])
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.url is string && request.resource.data.url.matches('data:image/.*')
        && request.resource.data.url.size() < 300000;
      allow delete: if editor() || (member() && resource.data.by == request.auth.token.email);
    }
    match /docs/{id} {
      allow read: if reader();
      allow create: if editor() || (reader() && mine(request.resource.data));
      allow update: if editor() || (reader() && mine(resource.data) && mine(request.resource.data));
      allow delete: if editor();
    }
    // A new upload's cover is saved just before its doc, so anyone who can upload may create one for a doc not saved yet.
    match /thumbs/{id} {
      allow read: if reader();
      allow write: if editor();
      allow create: if reader() && !exists(/databases/$(database)/documents/docs/$(id))
        && request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string && request.resource.data.data.matches('data:image/.*')
        && request.resource.data.data.size() < 300000;
    }
    // The site deletes someone's own folder only when it is empty; rules cannot check that.
    match /folders/{id} {
      allow read: if reader();
      allow create: if editor() || (reader() && mine(request.resource.data) && inFolder(request.resource.data));
      allow update: if editor() || (reader() && mine(resource.data) && mine(request.resource.data) && inFolder(request.resource.data));
      allow delete: if editor() || (reader() && mine(resource.data));
    }
    match /clubs/{id} {
      allow read: if member();
      allow write: if editor();
    }
  }
}
